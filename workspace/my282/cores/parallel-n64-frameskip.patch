+/* MinUI+: a frame the frontend's behind on isn't drawn at all, rather than drawn and
+ * hidden: once it asks (frame_hidden), the game's next frame is passed over, from its
+ * display lists to its swap, and the frame before it stays up. Never two in a row, and
+ * only while MINARCH_N64_SKIP_DRAWING is set. */
+extern "C" int frame_hidden;
+extern "C" int rice_skip_enabled;
+int rice_skip_enabled = 0;
+bool rice_skipping = false;
+bool rice_skip_passed = false; /* a display list was passed over */
+static bool rice_skip_asked = false;
+static int rice_skip_vis = 0;
+
+bool rice_frameFinished(void)
+{
+    if (rice_skipping && !rice_skip_passed)
+        return false; /* a swap with nothing behind it: the frame to pass over is still to come */
+    bool drawn = !rice_skipping;
+    rice_skipping = rice_skip_enabled && rice_skip_asked && drawn;
+    rice_skip_passed = false;
+    rice_skip_asked = false;
+    rice_skip_vis = 0;
+    return drawn;
+}
+
 void riceUpdateScreen(void)
 {
     status.bVIOriginIsUpdated = false;
 
+    if (frame_hidden)
+        rice_skip_asked = true;
+    if (rice_skipping && ++rice_skip_vis > 4) /* (a swap that only comes from a display list) */
+        rice_skipping = false;
+
     if (status.ToResize && status.gDlistCount > 0)
     {
        // Delete all OpenGL textures
@@ -562,6 +591,13 @@ void riceProcessRDPList(void)
 
 void riceProcessDList(void)
 {
+    static bool rice_skip_checked = false;
+    if (!rice_skip_checked)
+    {
+        rice_skip_checked = true;
+        rice_skip_enabled = getenv("MINARCH_N64_SKIP_DRAWING") != NULL;
+    }
+
     if( status.toShowCFB )
     {
         CRender::GetRender()->DrawFrameBuffer(true, 0, 0, 0, 0);
