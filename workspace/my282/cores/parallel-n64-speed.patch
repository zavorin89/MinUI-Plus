+/* Mario Tennis copies the screen to memory with the CPU for its replay wipes and
+ * "change court" panels. Rice never puts the picture in RDRAM, so that copy would be
+ * black: take it from the GPU once, when the game first draws it. */
+int FrameBufferManager::CopyScreenForAddress(uint32_t addr)
+{
+    SetImgInfo info;
+    memcpy(&info, &g_CI, sizeof(SetImgInfo));
+    info.dwAddr = addr;
+    info.dwFormat = g_uRecentCIInfoPtrs[0]->dwFormat;
+    info.dwSize = g_uRecentCIInfoPtrs[0]->dwSize;
+    info.dwWidth = g_uRecentCIInfoPtrs[0]->dwWidth;
+
+    int idx = SetBackBufferAsRenderTexture(info, 0);
+    gRenderTextureInfos[idx].copyUsedAtFrame = status.gDlistCount;
+    ((COGLRenderTexture*)gRenderTextureInfos[idx].pRenderTexture)->CopyScreen(gRenderTextureInfos[idx].bufferWidth, gRenderTextureInfos[idx].bufferHeight);
+    return idx;
+}
+
+/* A game that reads a framebuffer it isn't drawing wants that frame as it was finished,
+ * and Rice has just the one screen, which by then holds the next frame's clear (Mario
+ * Tennis: the replay snapshot it spins away). So while screen copies are being read,
+ * keep one of each frame as it ends. */
+void FrameBufferManager::CopyFinishedScreen(void)
+{
+    if (!g_uRecentCIInfoPtrs[0]->dwAddr)
+        return;
+
+    uint32_t addr = g_uRecentCIInfoPtrs[0]->dwAddr;
+    int mine = -1;
+    bool reading = false;
+    for (int i=0; i<numOfTxtBufInfos; i++)
+    {
+        if (!gRenderTextureInfos[i].isUsed || !gRenderTextureInfos[i].flipV)
+            continue;
+        if (status.gDlistCount - gRenderTextureInfos[i].copyUsedAtFrame <= 2)
+            reading = true;
+        if (gRenderTextureInfos[i].CI_Info.dwAddr == addr)
+            mine = i;
+    }
+    if (!reading)
+        return;
+
+    if (mine < 0)
+    {
+        mine = CopyScreenForAddress(addr);
+        gRenderTextureInfos[mine].copyUsedAtFrame = status.gDlistCount - 3;
+        return;
+    }
+    ((COGLRenderTexture*)gRenderTextureInfos[mine].pRenderTexture)->CopyScreen(gRenderTextureInfos[mine].bufferWidth, gRenderTextureInfos[mine].bufferHeight);
+}
