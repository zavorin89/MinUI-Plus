+
+extern bool rice_screenInRDRAM;
+extern int numOfRecentCIInfos;
+
+/* MinUI+: Banjo-Kazooie's jigsaw transition copies the screen out of N64 memory with the CPU, into
+ * the pieces, but Rice's picture is only on the GPU. The dynarec's reads of memory aren't hooked,
+ * so the copy can't be seen coming: memory is kept about a second behind the screen instead. */
+static void rice_storeScreen(void)
+{
+    static int frames;
+    static unsigned char *pixels;
+    if (++frames < 30)
+        return;
+    frames = 0;
+
+    int w = windowSetting.uDisplayWidth;
+    int h = windowSetting.uDisplayHeight;
+    static int pixels_size;
+    if (w*h*4 > pixels_size)
+    {
+        free(pixels);
+        pixels_size = w*h*4;
+        pixels = (unsigned char*)malloc(pixels_size);
+    }
+    if (!pixels)
+    {
+        pixels_size = 0;
+        return;
+    }
+    glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+
+    uint16_t *rdram = (uint16_t*)gfx_info.RDRAM;
+    for (int i = 0; i < numOfRecentCIInfos; i++)
+    {
+        RecentCIInfo &ci = *g_uRecentCIInfoPtrs[i];
+        /* only screens still in use: an old address may be something else by now */
+        if (!ci.dwAddr || ci.dwAddr == g_ZI.dwAddr || ci.dwFormat != G_IM_FMT_RGBA || ci.dwSize != G_IM_SIZ_16b
+            || ci.dwWidth < 200 || !ci.dwHeight || status.gDlistCount - ci.lastUsedFrame > 3
+            || ci.dwAddr + ci.dwWidth*ci.dwHeight*2 > g_dwRamSize)
+            continue;
+        uint32_t step = ((uint32_t)w << 16) / ci.dwWidth;
+        uint32_t first = ci.dwAddr >> 1;
+        for (uint32_t y = 0; y < ci.dwHeight; y++, first += ci.dwWidth)
+        {
+            const unsigned char *row = pixels + (h - 1 - y*h/ci.dwHeight)*w*4;
+            uint32_t sx = 0;
+            for (uint32_t x = 0; x < ci.dwWidth; x++, sx += step)
+            {
+                const unsigned char *c = row + (sx >> 16)*4;
+                rdram[(first + x)^1] = ((c[0] & 0xf8) << 8) | ((c[1] & 0xf8) << 3) | ((c[2] & 0xf8) >> 2) | 1;
+            }
+        }
+    }
+}
