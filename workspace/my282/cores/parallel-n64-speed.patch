+/* a target starts out holding this, not what it held last (and a clear also
+ * saves the GPU from loading the old pixels back in) */
+void rice_clearRenderTarget(uint32_t color)
+{
+    GLboolean depthMask = GL_TRUE;
+    glGetBooleanv(GL_DEPTH_WRITEMASK, &depthMask);
+    glDisable(GL_SCISSOR_TEST);
+    glDepthMask(GL_TRUE);
+    glClearColor(((color>>16)&0xFF)/255.0f, ((color>>8)&0xFF)/255.0f, (color&0xFF)/255.0f, ((color>>24)&0xFF)/255.0f);
+    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
+    glDepthMask(depthMask);
+    glEnable(GL_SCISSOR_TEST);
+}
+
 bool COGLRenderTexture::InitPBuffer( void )
 {
+    if( !m_pOGLTexture )
+        return false;
+
+    glGenRenderbuffers(1, &m_depth);
+    glBindRenderbuffer(GL_RENDERBUFFER, m_depth);
+    glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH_COMPONENT16,
+        m_pOGLTexture->m_dwCreatedTextureWidth, m_pOGLTexture->m_dwCreatedTextureHeight);
+
+    glGenFramebuffers(1, &m_fbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, m_fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_pOGLTexture->m_dwTextureName, 0);
+    glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, m_depth);
+
+    if( glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE )
+    {
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        ShutdownPBuffer();
+        return false;
+    }
+
     return true;
 }
 
 void COGLRenderTexture::ShutdownPBuffer(void)
 {
+    if( m_fbo )
+        glDeleteFramebuffers(1, &m_fbo);
+    if( m_depth )
+        glDeleteRenderbuffers(1, &m_depth);
+    m_fbo = 0;
+    m_depth = 0;
