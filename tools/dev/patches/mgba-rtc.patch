+// MinUI+: allow ROM hacks with unrecognized headers to request cartridge RTC.
+// Auto preserves mGBA's detection; applying after state load prevents old states
+// from silently removing a newly enabled RTC. Never reset an existing RTC offset.
+static void _applyForcedRTC(void) {
+#ifdef M_CORE_GBA
+	struct retro_variable var = { "mgba_force_rtc", NULL };
+	if (core && core->platform(core) == mPLATFORM_GBA &&
+		environCallback(RETRO_ENVIRONMENT_GET_VARIABLE, &var) &&
+		var.value && !strcmp(var.value, "ON")) {
+		struct GBA* gba = core->board;
+		if (!(gba->memory.hw.devices & HW_RTC)) GBAHardwareInitRTC(&gba->memory.hw);
+	}
+#endif
+}
